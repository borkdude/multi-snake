{:paths ["src"]
 ;; Pinned, so the container and this machine run the same Buzz. To work
 ;; against a checkout instead:
 ;;
 ;;   bb -Sdeps '{:deps {io.github.borkdude/buzz {:local/root "../buzz"}}}' serve
 :deps {io.github.borkdude/buzz {:git/sha "8e704ad61f4565ba95a6279a1e645df86d47bcd2"}}
 :tasks {serve {:doc "Play on http://localhost:1350"
                :requires ([snake.main :as main])
                :task (main/-main)}
         dev   {:doc "The same, plus an nrepl on 1668"
                :requires ([snake.main :as main])
                :task (main/-main "--nrepl")}}}
